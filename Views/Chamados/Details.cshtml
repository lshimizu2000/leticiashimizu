@model HelpDeskMvc.Models.Chamado

@{
    ViewData["Title"] = "Detalhes do chamado";
}

<h1>Chamado #@Model.Id</h1>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">
            @Model.Titulo
        </h4>

        <dl class="row mt-4">
            <dt class="col-sm-3">Descrição</dt>
            <dd class="col-sm-9">@Model.Descricao</dd>

            <dt class="col-sm-3">Solicitante</dt>
            <dd class="col-sm-9">@Model.Solicitante</dd>

            <dt class="col-sm-3">Prioridade</dt>
            <dd class="col-sm-9">@Model.Prioridade</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Data de abertura</dt>
            <dd class="col-sm-9">
                @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")
            </dd>
        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Editar
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>
    </div>
</div>